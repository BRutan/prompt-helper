{
  "manifest_version": 3,
  "name": "prompt-helper: Session Patches",
  "version": "0.4.0",
  "description": "Manual session prompt preview and Git diff preparation; no ChatGPT response monitoring or automated submission.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "prompt-helper"
  }
}
