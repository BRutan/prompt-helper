{
  "manifest_version": 3,
  "name": "prompt-helper: Session Patches",
  "version": "0.3.0",
  "description": "Tracks completed AI replies and applies downloaded Git patches to selected local repositories.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js",
        "delivery-content.js",
        "response-monitor.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "prompt-helper session diff"
  }
}
